# .npmrc — Deterministic package management (Big Tech standard)
# Enforces reproducible installs, exact versions, and engine compliance.

# Fail install if Node.js version does not satisfy engines.node (>=22.0.0)
engine-strict=true

# Lock exact versions in package.json (no ^ or ~ ranges)
save-exact=true

# Always generate and use lockfile
package-lock=true

# Disable fund solicitation (noise in CI logs)
fund=false

# Audit handled by dedicated CI stage (verify-cicd-pipeline Stage 1)
audit=false
