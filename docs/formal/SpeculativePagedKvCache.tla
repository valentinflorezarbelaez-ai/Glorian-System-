----------------------- MODULE SpeculativePagedKvCache -----------------------
(***************************************************************************)
(* Formal TLA+ specification of Paged KV-Cache virtual memory allocation   *)
(* and speculative multi-token draft verification.                         *)
(* Verified with Leslie Lamport's TLC Model Checker.                       *)
(***************************************************************************)

EXTENDS Integers, Sequences, FiniteSets, TLC

CONSTANTS 
    TotalBlocks,    \* Total physical memory blocks (e.g. 4)
    BlockSize,      \* Tokens per block (e.g. 2)
    MaxDraftTokens  \* Maximum draft tokens K (e.g. 3)

VARIABLES 
    freeBlocks,     \* Set of currently available physical block IDs
    pageTableA,     \* Sequence A: sequence of assigned physical block IDs
    tokensA,        \* Number of tokens in sequence A
    pageTableB,     \* Sequence B: sequence of assigned physical block IDs
    tokensB,        \* Number of tokens in sequence B
    draftSeq,       \* Speculative candidate tokens generated by draft model
    targetSeq,      \* Ground-truth tokens computed by target model
    acceptedSeq     \* Final accepted tokens after speculative verification

vars == <<freeBlocks, pageTableA, tokensA, pageTableB, tokensB, draftSeq, targetSeq, acceptedSeq>>

AllBlocks == 1..TotalBlocks

(***************************************************************************)
(* Helper: Range of a Sequence                                             *)
(***************************************************************************)
SeqRange(s) == { s[i] : i \in 1..Len(s) }

(***************************************************************************)
(* Ceiling Division for Block Requirement Calculation                     *)
(***************************************************************************)
RequiredBlocks(numTokens) ==
    IF numTokens = 0 THEN 0
    ELSE ((numTokens - 1) \div BlockSize) + 1

(***************************************************************************)
(* Initial State Predicate                                                 *)
(***************************************************************************)
Init ==
    /\ freeBlocks = AllBlocks
    /\ pageTableA = <<>>
    /\ tokensA = 0
    /\ pageTableB = <<>>
    /\ tokensB = 0
    /\ draftSeq = <<>>
    /\ targetSeq = <<>>
    /\ acceptedSeq = <<>>

(***************************************************************************)
(* Action: Allocate / Extend Sequence A                                    *)
(***************************************************************************)
AllocateA ==
    /\ tokensA < BlockSize * 2
    /\ \E b \in freeBlocks:
        LET newTokens == tokensA + 1
            newReq == RequiredBlocks(newTokens)
        IN
            IF newReq > Len(pageTableA) THEN
                /\ freeBlocks' = freeBlocks \ {b}
                /\ pageTableA' = Append(pageTableA, b)
                /\ tokensA' = newTokens
                /\ UNCHANGED <<pageTableB, tokensB, draftSeq, targetSeq, acceptedSeq>>
            ELSE
                /\ tokensA' = newTokens
                /\ UNCHANGED <<freeBlocks, pageTableA, pageTableB, tokensB, draftSeq, targetSeq, acceptedSeq>>

(***************************************************************************)
(* Action: Allocate / Extend Sequence B                                    *)
(***************************************************************************)
AllocateB ==
    /\ tokensB < BlockSize * 2
    /\ \E b \in freeBlocks:
        LET newTokens == tokensB + 1
            newReq == RequiredBlocks(newTokens)
        IN
            IF newReq > Len(pageTableB) THEN
                /\ freeBlocks' = freeBlocks \ {b}
                /\ pageTableB' = Append(pageTableB, b)
                /\ tokensB' = newTokens
                /\ UNCHANGED <<pageTableA, tokensA, draftSeq, targetSeq, acceptedSeq>>
            ELSE
                /\ tokensB' = newTokens
                /\ UNCHANGED <<freeBlocks, pageTableA, tokensA, pageTableB, draftSeq, targetSeq, acceptedSeq>>

(***************************************************************************)
(* Action: Free Sequence A                                                 *)
(***************************************************************************)
FreeA ==
    /\ Len(pageTableA) > 0
    /\ freeBlocks' = freeBlocks \cup SeqRange(pageTableA)
    /\ pageTableA' = <<>>
    /\ tokensA' = 0
    /\ UNCHANGED <<pageTableB, tokensB, draftSeq, targetSeq, acceptedSeq>>

(***************************************************************************)
(* Action: Free Sequence B                                                 *)
(***************************************************************************)
FreeB ==
    /\ Len(pageTableB) > 0
    /\ freeBlocks' = freeBlocks \cup SeqRange(pageTableB)
    /\ pageTableB' = <<>>
    /\ tokensB' = 0
    /\ UNCHANGED <<pageTableA, tokensA, draftSeq, targetSeq, acceptedSeq>>

(***************************************************************************)
(* Action: Generate Draft Tokens for Sequence A                            *)
(***************************************************************************)
DraftTokens ==
    /\ tokensA > 0
    /\ draftSeq = <<>>
    /\ \E d \in { <<10, 20, 30>>, <<10, 25, 30>>, <<15, 20, 30>> }:
        /\ draftSeq' = d
        /\ targetSeq' = <<10, 20, 40, 50>> \* Target model distribution
        /\ acceptedSeq' = <<>>
        /\ UNCHANGED <<freeBlocks, pageTableA, tokensA, pageTableB, tokensB>>

(***************************************************************************)
(* Action: Parallel Verify Speculative Tokens                              *)
(***************************************************************************)
VerifyDraft ==
    /\ draftSeq /= <<>>
    /\ acceptedSeq = <<>>
    /\ LET 
         \* Determine first mismatch index
         match1 == (draftSeq[1] = targetSeq[1])
         match2 == match1 /\ (draftSeq[2] = targetSeq[2])
         match3 == match2 /\ (draftSeq[3] = targetSeq[3])
       IN
         IF match3 THEN
             \* All 3 accepted + 1 target token = 4 tokens
             /\ acceptedSeq' = <<draftSeq[1], draftSeq[2], draftSeq[3], targetSeq[4]>>
             /\ draftSeq' = <<>>
             /\ UNCHANGED <<freeBlocks, pageTableA, tokensA, pageTableB, tokensB, targetSeq>>
         ELSE IF match2 THEN
             \* 2 accepted + target token 3 = 3 tokens
             /\ acceptedSeq' = <<draftSeq[1], draftSeq[2], targetSeq[3]>>
             /\ draftSeq' = <<>>
             /\ UNCHANGED <<freeBlocks, pageTableA, tokensA, pageTableB, tokensB, targetSeq>>
         ELSE IF match1 THEN
             \* 1 accepted + target token 2 = 2 tokens
             /\ acceptedSeq' = <<draftSeq[1], targetSeq[2]>>
             /\ draftSeq' = <<>>
             /\ UNCHANGED <<freeBlocks, pageTableA, tokensA, pageTableB, tokensB, targetSeq>>
         ELSE
             \* 0 accepted + target token 1 = 1 token
             /\ acceptedSeq' = <<targetSeq[1]>>
             /\ draftSeq' = <<>>
             /\ UNCHANGED <<freeBlocks, pageTableA, tokensA, pageTableB, tokensB, targetSeq>>

(***************************************************************************)
(* Reset Verification State                                                *)
(***************************************************************************)
ResetVerification ==
    /\ acceptedSeq /= <<>>
    /\ acceptedSeq' = <<>>
    /\ targetSeq' = <<>>
    /\ UNCHANGED <<freeBlocks, pageTableA, tokensA, pageTableB, tokensB, draftSeq>>

(***************************************************************************)
(* Next State Relation                                                     *)
(***************************************************************************)
Next ==
    \/ AllocateA
    \/ AllocateB
    \/ FreeA
    \/ FreeB
    \/ DraftTokens
    \/ VerifyDraft
    \/ ResetVerification

Spec == Init /\ [][Next]_vars

(***************************************************************************)
(* INVARIANTS                                                              *)
(***************************************************************************)

\* Invariant 1: Total Physical Blocks Conservation
BlockConservation ==
    Cardinality(freeBlocks) + Len(pageTableA) + Len(pageTableB) = TotalBlocks

\* Invariant 2: No Block Sharing or Overlapping Allocations
NoSharedBlocks ==
    /\ (SeqRange(pageTableA) \cap SeqRange(pageTableB)) = {}
    /\ (SeqRange(pageTableA) \cap freeBlocks) = {}
    /\ (SeqRange(pageTableB) \cap freeBlocks) = {}
    /\ Cardinality(SeqRange(pageTableA)) = Len(pageTableA)
    /\ Cardinality(SeqRange(pageTableB)) = Len(pageTableB)

\* Invariant 3: Page Table Monotonic Ceiling Bounds
PageTableBounds ==
    /\ Len(pageTableA) = RequiredBlocks(tokensA)
    /\ Len(pageTableB) = RequiredBlocks(tokensB)
    /\ Len(pageTableA) <= TotalBlocks
    /\ Len(pageTableB) <= TotalBlocks

\* Invariant 4: Speculative Exact Target Subsequence Equivalence
SpeculativeEquivalence ==
    acceptedSeq /= <<>> =>
        \A i \in 1..Len(acceptedSeq):
            acceptedSeq[i] = targetSeq[i]

=============================================================================
