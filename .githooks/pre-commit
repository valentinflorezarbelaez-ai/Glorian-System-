#!/bin/sh
set -eu
REPO_ROOT=$(git rev-parse --show-toplevel)
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
node "$REPO_ROOT/scripts/verify-cicd-pipeline.mjs"
# Fold verify-rewritten tip-seal evidence into the commit index (porcelain for pulse A+).
git add -u -- \
  "$REPO_ROOT/docs/evidence/sbom.cdx.json" \
  "$REPO_ROOT/docs/evidence/provenance.intoto.jsonl" \
  "$REPO_ROOT/docs/evidence/fleet-audit.sarif" \
  "$REPO_ROOT/docs/contracts/mcp-tool-catalog.json" \
  "$REPO_ROOT/docs/specs/openspec-catalog-index.json" \
  "$REPO_ROOT/docs/products/demo-ledger-mvp" \
  || true
