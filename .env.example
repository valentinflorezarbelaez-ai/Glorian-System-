# EOS SYSTEM — Environment Configuration
# Copy this file to .env and adjust paths for your machine.
# None of these are secrets — they are filesystem path overrides.

# ── Fleet base directory (default: OS home dir) ───────────────────────────
# All EOS_PATH_* variables fall back to $EOS_FLEET_BASE/<project-dir>
# If EOS_FLEET_BASE is unset, the OS home directory ($USERPROFILE / $HOME) is used.
EOS_FLEET_BASE=C:\Users\valen

# ── Per-project path overrides (optional) ────────────────────────────────
# Set any of these to override the default <EOS_FLEET_BASE>/<dir> resolution.
# EOS_PATH_EOS_SYSTEM=C:\Users\valen\Eos-System
# EOS_PATH_ABERAMENTHO=C:\Users\valen\Aberamentho-s-Pleroma-music
# EOS_PATH_PORTAFOLIO=C:\Users\valen\portafolio
# EOS_PATH_PTG=C:\Users\valen\Performance-Talent-Group-1
