{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "glorian-sample-workload"
  },
  "spec": {
    "securityContext": {
      "runAsNonRoot": true
    },
    "containers": [
      {
        "name": "worker",
        "image": "busybox:1.36.1",
        "securityContext": {
          "privileged": false,
          "allowPrivilegeEscalation": false
        },
        "resources": {
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        }
      }
    ]
  }
}
