# Auto-detect text files and normalize line endings to LF (deterministic cross-platform)
* text=auto eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary
*.wasm binary
*.exe binary
*.pdf binary

# Windows scripts require CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Enforce linguist-language hints for GitHub language stats
*.ts.snap linguist-generated
*.sarif linguist-generated
package-lock.json linguist-generated
